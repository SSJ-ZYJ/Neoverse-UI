{
  "name": "@neoverse-ui/vue",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Vue 3 components for the Neoverse UI design system.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSJ-ZYJ/Neoverse-UI.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/SSJ-ZYJ/Neoverse-UI#readme",
  "bugs": {
    "url": "https://github.com/SSJ-ZYJ/Neoverse-UI/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && vue-tsc --project tsconfig.build.json --emitDeclarationOnly && vite build && bun ./scripts/copy-css.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": ">=3.5.0 <4.0.0"
  },
  "dependencies": {
    "@neoverse-ui/motion": "^0.2.2",
    "@neoverse-ui/overlay-runtime": "^0.3.1",
    "@neoverse-ui/tailwind": "^0.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
