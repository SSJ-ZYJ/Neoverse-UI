{
  "name": "@neoverse-ui/vue",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Vue 3 components for the Neoverse UI design system.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SSJ-ZYJ/Neoverse-UI.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/SSJ-ZYJ/Neoverse-UI#readme",
  "bugs": {
    "url": "https://github.com/SSJ-ZYJ/Neoverse-UI/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && vue-tsc --project tsconfig.build.json --emitDeclarationOnly && vite build && bun ./scripts/copy-css.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --environment happy-dom"
  },
  "peerDependencies": {
    "vue": ">=3.4.0 <4.0.0"
  },
  "dependencies": {
    "@neoverse-ui/tailwind": "^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.11.10",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
