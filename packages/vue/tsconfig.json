{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "types": ["bun-types", "node", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
