* text=auto eol=lf

# Keep Windows shell launchers native when they are added.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be normalized as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
