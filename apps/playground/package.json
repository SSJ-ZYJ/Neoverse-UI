{
  "name": "@neoverse-ui/playground",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:client": "vite build --watch --mode development",
    "build:client": "vite build --mode production",
    "build": "bun run build:client && bun build ./src/index.ts --outdir ./dist --target bun --sourcemap",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun run --filter @neoverse-ui/tokens build && bun run --filter @neoverse-ui/motion build && bun test src/lab-data.test.ts src/asset-state.test.ts src/theme-runtime.test.ts"
  },
  "dependencies": {
    "@neoverse-ui/giscus-theme": "workspace:*",
    "@neoverse-ui/glass-runtime": "workspace:*",
    "@neoverse-ui/motion": "workspace:*",
    "@neoverse-ui/react": "workspace:*",
    "@neoverse-ui/tailwind": "workspace:*",
    "@neoverse-ui/tokens": "workspace:*",
    "@neoverse-ui/vue": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.7",
    "vue-tsc": "^3.3.14"
  }
}
